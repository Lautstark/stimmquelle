{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    // Pinned, rather than left to be inferred. `catalogue.ts` imports
    // `../voices.json`, which without this drags the package root into the
    // inferred rootDir and pushes the whole build down into `dist/src/` — where
    // none of the entry points package.json declares were pointing. `dist/`
    // sits at the same depth as `src/`, so the emitted `../voices.json` still
    // resolves to the one audited copy at the root rather than to a second copy
    // beside it.
    "rootDir": "src",
    // `vite.ts` is a build-time plugin and imports node:fs — the one part of
    // this package that runs on a build machine rather than in a tab. Nothing
    // else may: the chain stays free of node so the same code runs in a browser
    // and under a test that checks it against ffmpeg.
    "types": ["node"]
  },
  "include": ["src"]
}
