{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM.Iterable joined the day `voice-picker.ts` arrived: a NodeList is
    // iterable in every browser this package runs in, and without it a
    // `[...node.querySelectorAll(…)]` does not compile. Type declarations only
    // — it emits nothing and widens no runtime target. @lautstark/bildquelle
    // carries the same three for the same reason.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Named rather than inherited: TypeScript 6 includes no @types package
    // unless asked, and vitest 5's types stopped bringing Node's in with them.
    // src/vite.ts and the tests read node:fs and node:path.
    "types": ["node"]
  },
  "include": ["src", "test"]
}
